# Multi-stage build for midnight-manual-server (FR-102, SC-058: <50MB compressed)

# ----- builder stage -----
# Pinned to workspace MSRV (Cargo.toml [workspace.package].rust-version). Bump
# both together — a stale image tag will fail on any transitive dep that
# raised its own MSRV past the image's compiler (cargo-platform / time /
# gauge-events / etc. have done this multiple times in the 1.83 → 1.93 window).
FROM rust:1.93-bookworm AS builder

WORKDIR /app

# cargo-chef for layer caching of dependency build
RUN cargo install cargo-chef --locked --version 0.1.68

# Plan: capture the dep tree
COPY Cargo.toml Cargo.lock* ./
COPY crates/ ./crates/
RUN cargo chef prepare --recipe-path recipe.json

# Cook: build deps from the plan
RUN cargo chef cook --release --recipe-path recipe.json -p midnight-manual-server

# Build: actual server binary
COPY . .
RUN cargo build --release --bin midnight-manual-server

# ----- runtime stage -----
FROM gcr.io/distroless/cc-debian12 AS runtime

# Per FR-102: server image contains only the server binary; CLI binaries are absent.
COPY --from=builder /app/target/release/midnight-manual-server /usr/local/bin/midnight-manual-server

# Migrations baked in
COPY --from=builder /app/crates/mnm-store/migrations /migrations

EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/midnight-manual-server"]
