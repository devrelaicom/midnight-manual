{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "MCP `tools/list` manifest for the 13 tools exposed by `mnm mcp serve`, in canonical registration order (search pair, chunk reads, document reads, corpus discovery, diagnostics, local install). Each tool's name, description, inputSchema, outputSchema, and annotations are part of the public contract per Constitution I and FR-037. The runtime manifest at `crates/mn-mcp/src/tools.rs::list()` is the single source of truth: the `tools` key below is generated from it verbatim (MCP wire format) and enforced by `crates/mn-mcp/tests/contract_sync.rs`. Regenerate with `REGENERATE_CONTRACT=1 cargo test -p mn-mcp --test contract_sync`. Embedded schemas use JSON Schema draft 2020-12. A success result carries one text content block (summary plus a fenced trimmed-JSON view) and full-fidelity `structuredContent` conforming to the tool's outputSchema, including `suggested_next_actions`; failures use the shared envelope described under `error_envelope`.",
  "error_envelope": {
    "codes": {
      "CLOUD_ERROR": {
        "description": "The cloud API returned a transient or permanent error. Call `status` to diagnose if it persists.",
        "retryable": true
      },
      "EMBEDDING_MODEL_MISMATCH": {
        "description": "The embedding model used for the query does not match the corpus's active model (FR-038 / D12). The cloud-provided `remediation` string is the next step; there is no suggested tool call because the mismatch is corpus-side.",
        "details": {
          "client_model": "string ({name}@{revision} the client embedded with)",
          "corpus_model": "string ({name}@{revision} of the corpus's active embedder)",
          "remediation": "string (concrete next step, cloud-provided)"
        },
        "raised_by": [
          "search",
          "advanced_search"
        ],
        "retryable": false
      },
      "INSTALL_FAILED": {
        "description": "The skill file could not be written to the target harness directory.",
        "raised_by": [
          "install_search_skill"
        ],
        "retryable": true
      },
      "INVALID_INPUT": {
        "description": "An argument failed validation. Fix the arguments and retry.",
        "retryable": true
      },
      "NOT_FOUND": {
        "description": "The requested chunk, document, or source does not exist. Re-derive the id (e.g. from a fresh search) before trying again.",
        "retryable": false
      }
    },
    "description": "Tool failures are MCP tool results with `isError: true` — not JSON-RPC errors. `structuredContent` carries `{ error: { code, retryable, message, ...details }, suggested_next_actions: [..] }`; the text content block carries agent-facing recovery guidance plus a trimmed `{\"error\":{\"code\",\"retryable\"}}` JSON fence. `code` is a closed set (below). `retryable: false` means an identical retry cannot succeed — recovery requires a different call; follow `suggested_next_actions` or the guidance text. Defined in `crates/mn-mcp/src/render.rs` (`ErrorKind`, `ToolFailure`)."
  },
  "title": "midnight-manual MCP tools",
  "tools": [
    {
      "annotations": {
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Search the Midnight Network documentation and code corpus (docs, SDK references, Compact language material, code examples). Returns ranked excerpts with confidence scores and source attribution. Use it whenever you need facts about Midnight, Compact, or the Midnight SDK. For multi-query strategies, facet filters, or rerank control, use advanced_search.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "limit": {
            "default": 10,
            "description": "Max results returned.",
            "maximum": 50,
            "minimum": 1,
            "type": "integer"
          },
          "mode": {
            "default": "hybrid",
            "description": "hybrid (default) fuses keyword + semantic; fts is keyword-only (lowest latency); vector is semantic-only.",
            "enum": [
              "hybrid",
              "vector",
              "fts"
            ],
            "type": "string"
          },
          "query": {
            "description": "What you want to find, as natural language or code terms.",
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "type": "object"
      },
      "name": "search",
      "outputSchema": {
        "additionalProperties": true,
        "properties": {
          "corpus_embedding_model": {
            "type": "string"
          },
          "results": {
            "items": {
              "additionalProperties": true,
              "properties": {
                "chunk_id": {
                  "type": "string"
                },
                "content": {
                  "type": "string"
                },
                "document_id": {
                  "type": "string"
                },
                "heading_path": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "source_display_name": {
                  "type": "string"
                },
                "source_path": {
                  "type": "string"
                },
                "source_slug": {
                  "type": "string"
                },
                "symbol_path": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "search_metadata": {
            "additionalProperties": true,
            "type": "object"
          },
          "suggested_next_actions": {
            "items": {
              "properties": {
                "arguments": {
                  "type": "object"
                },
                "description": {
                  "description": "What this suggested action achieves. Actions are suggestions, not required next steps.",
                  "type": "string"
                },
                "tool": {
                  "description": "Tool to call. Absent for actions the user (not the agent) must take.",
                  "type": "string"
                }
              },
              "required": [
                "description"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "results"
        ],
        "type": "object"
      }
    },
